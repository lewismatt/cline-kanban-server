# Server Configuration
# The port on which the kanban server will listen for incoming requests.
PORT=3000

# Environment
# The runtime environment for the application. Set to one of: development, production, test.
NODE_ENV=development

# Database
# Full PostgreSQL connection URL used by the server to connect to the database.
DATABASE_URL=postgresql://localhost:5432/kanban_server

# Authentication
# Secret key used to sign and verify JWT tokens. MUST be replaced with a unique, high-entropy value in production.
JWT_SECRET=your-secret-key-change-this-in-production

# CORS
# Allowed origin(s) for cross-origin requests. Comma-separated values are supported.
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
# Maximum number of allowed requests within the configured time window per client.
RATE_LIMIT_MAX=100
